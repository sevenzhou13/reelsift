DATABASE_URL=sqlite:///./data/reelsift.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://reelsift:password@127.0.0.1:5432/reelsift

ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_STYLE=chat
ARK_MODEL=your_ark_endpoint_id_or_model

# 故事线/脚本生成模型。未配置时会回退到 ARK_*。
STORY_API_KEY=your_story_api_key_here
STORY_BASE_URL=https://api.deepseek.com
STORY_MODEL=your_story_model
# 可选：三个故事方向和拖动解释使用更快的模型；未配置时回退到 STORY_MODEL。
STORY_FAST_MODEL=deepseek-flash
STORY_TIMEOUT_SECONDS=120

# 可选：继续使用同一个 OpenAI-compatible Story adapter，但复用供应商已有变量。
# 设置 STORY_PROVIDER 为 QWEN / DEEPSEEK / DOUBAO；STORY_* 始终优先。
# STORY_PROVIDER=QWEN
# QWEN_API_KEY=your_qwen_api_key_here
# QWEN_BASE_URL=https://your-openai-compatible-qwen-endpoint/v1
# QWEN_MODEL=your_qwen_model
#
# STORY_PROVIDER=DEEPSEEK
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=your_deepseek_model
#
# STORY_PROVIDER=DOUBAO
# DOUBAO_API_KEY=your_doubao_api_key_here
# DOUBAO_BASE_URL=https://your-openai-compatible-doubao-endpoint/v1
# DOUBAO_MODEL=your_doubao_model

VOLC_SPEECH_API_KEY=your_volc_speech_api_key_here
VOLC_SPEECH_RESOURCE_ID=volc.bigasr.auc_turbo
VOLC_SPEECH_UID=reelsift
